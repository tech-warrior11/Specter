ENVIRONMENT=production
LOG_LEVEL=INFO

# Application Security
APP_NAME=Specter
API_V1_PREFIX=/api
JWT_SECRET=your_secure_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
CORS_ORIGINS=*

# Relational Database
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
POSTGRES_DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
POSTGRES_SYNC_DATABASE_URL=postgresql://user:password@host/dbname

# Graph Database
NEO4J_URI=neo4j+s://your_neo4j_instance.databases.neo4j.io
NEO4J_USERNAME=neo4j_user
NEO4J_PASSWORD=neo4j_password
USE_IN_MEMORY_GRAPH=false

# Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Optional Grounded AI Provider
AI_PROVIDER=local_mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048

# Storage Vault
EVIDENCE_VAULT_DIR=./data/evidence_vault
MAX_UPLOAD_SIZE_MB=25

# Demonstration Lab Mode (Set to false for real data)
DEMO_LAB_MODE=false

# Seeded User Passwords (for synthetic data testing)
SEED_ADMIN_PASSWORD=
SEED_HUNTER_PASSWORD=
SEED_ANALYST_PASSWORD=
SEED_VIEWER_PASSWORD=
